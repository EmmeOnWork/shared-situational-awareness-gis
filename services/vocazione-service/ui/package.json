{
  "name": "vocazione-widget-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Self-contained UI bundle (custom element <vocazione-widget>) for the vocazione widget service (Vocazione Selector).",
  "scripts": {
    "build": "esbuild src/vocazione-widget.ts --bundle --minify --format=iife --target=es2020 --outfile=dist/vocazione-widget.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
