# ─────────────────────────────────────────────────────────────────────────────
#  LOCAL-DEV DEFAULTS — committed on purpose. Copy and go:
#      cp .env.example .env  &&  docker compose up -d --build
#  These are the SAME defaults baked into docker-compose.yml, so the first boot is
#  identical with or without this file, and the stack comes up fully working
#  (auth included). ⚠️ NOT secure — replace every password/secret for staging/prod.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Postgres (local service: ju-postgres) ----
# POSTGRESQL_URI / DATABASE_URL at the pooler URL (remember --schema=public).
POSTGRES_USER=janus
POSTGRES_PASSWORD=CHANGE_ME   # DEFAULT password — change it for staging/prod
POSTGRES_DB=janus
# Monolith (SQLAlchemy + psycopg v3) and widget share this DB + public schema.
POSTGRESQL_URI=postgresql+psycopg://janus:CHANGE_ME@ju-postgres:5432/janus
DATABASE_URL=postgresql+psycopg://janus:CHANGE_ME@ju-postgres:5432/janus

# ---- Mongo (local service: ju-mongodb, no auth) ----
MONGODB_URI=mongodb://ju-mongodb:27017
MONGODB_DB=janus

# ---- Monolith misc (config.py requires these or it crashes) ----
# OpenRouter is only hit by AI routes (Euklid); a placeholder is enough to boot locally.
OPENROUTER_API_KEY=sk-local-dev-unused

# ---- JWT — shared HS256 dev secret (DEFAULT, not a real secret) ----
# HS256 (local): the SAME value for signing (JWT_PRIVATE_KEY) and verifying
# (JWT_VERIFICATION_KEY) on BOTH monolith and widget — otherwise token
# verification fails with 401. RS256 (staging/prod): PRIVATE=private PEM,
# VERIFICATION=public PEM (a \n-escaped single line is accepted).
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_PRIVATE_KEY=CHANGE_ME
JWT_VERIFICATION_KEY=CHANGE_ME

# ---- Frontend (single origin = the gateway) ----
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
# Placeholders — fill in only if you use these frontend integrations.
NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://il-tuo-endpoint/graphql
