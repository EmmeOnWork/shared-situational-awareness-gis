# Edge-gateway test config. Copy to .env (git-ignored) and fill in for your
# machine: `cp .env.example .env`. The test harness loads .env automatically.
#
# CADDY_BIN — absolute path to the Caddy binary the routing-contract tests launch.
# Only needed when `caddy` is not on PATH; if it is, leave this unset and the
# harness finds it. When neither resolves, the live-gateway tests skip (not fail).
#
#   Windows (winget):
#     CADDY_BIN=C:\Users\<you>\AppData\Local\Microsoft\WinGet\Packages\CaddyServer.Caddy_Microsoft.Winget.Source_8wekyb3d8bbwe\caddy.exe
#   Linux / macOS:
#     CADDY_BIN=/usr/bin/caddy
CADDY_BIN=
