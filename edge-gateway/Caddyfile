# Edge gateway — the single routing file (ADR-0002).
#
# One origin in front of the whole stack. Explicit API/widget prefixes route to
# their backend services; everything the gateway does is reverse-proxying — no
# business logic lives here. The site address and the upstream addresses are
# injected per environment via Caddy env substitution ({$VAR}), so this same file
# runs unchanged whether an upstream is a local port, a compose service name, or a
# staging/prod internal host.
#
# Routing model: explicit backend prefixes are matched first; the Next frontend is
# the catch-all default. The frontend owns the browser origin — it serves the
# pages (/, /dashboard, /login, …), the framework assets under /_next/*, and the
# public files (/favicon.ico, /images/*). Those paths are open-ended and grow with
# every new page, so they CANNOT be enumerated; the backend's API surface is the
# finite, enumerable side, so that is what we list. (This reverses the earlier
# draft, where only "/" went to the frontend and the monolith was the catch-all:
# under that rule every /_next/* asset fell through to FastAPI and 404'd, so the
# frontend rendered with no CSS/JS. See the routing-contract tests.)

{
	admin off
}

# The injected site address IS the per-environment TLS toggle (ADR-0002, Module 2).
# A port-only / http:// address — e.g. :8080 locally — serves plain HTTP, so local
# iteration has no certificate friction. A hostname — e.g. gateway.example.edu in
# staging/prod — makes Caddy provision and serve automatic HTTPS, and realtime
# rides it as WSS for free. Same file, same routing logic; only this one injected
# value differs across local → staging → prod.
{$GATEWAY_SITE_ADDRESS} {
	# --- Widget services: each claims a fresh top-level prefix (ADR-0002) ---
	#
	# /demographics → demographic-service. Path is preserved (the service mounts
	# its routes under /demographics), and the upstream is never hard-coded.
	reverse_proxy /demographics* {$DEMOGRAPHIC_UPSTREAM}

	# /characteristic → characteristic-service (write Widget: Scheda + Blueprints).
	# Path is preserved (the service mounts its routes and its bundle under
	# /characteristic), and the upstream is injected per-environment.
	reverse_proxy /characteristic* {$CHARACTERISTIC_UPSTREAM}

	# /reuse → reuse-service (Workshop Selector: owns the building_workshop registry,
	# serves the Bene toggle-list and its bundle under /reuse). Path is preserved and
	# the upstream is injected per-environment.
	reverse_proxy /reuse* {$REUSE_UPSTREAM}

	# /vocazione → vocazione-service (Vocazione Selector: a client-only Widget that
	# owns no data route — it serves only its bundle under /vocazione/widget.js and
	# self-registers in the catalog). Path is preserved and the upstream is injected
	# per-environment.
	reverse_proxy /vocazione* {$VOCAZIONE_UPSTREAM}

	# /notifications → notification-service (Realtime Notifier: a page-global
	# overlay Widget that serves its bundle under /notifications/widget.js and,
	# in a later slice, holds the authenticated WebSocket). Path is preserved and
	# the upstream is injected per-environment. No special config is needed for the
	# WebSocket upgrade — Caddy reverse_proxy carries upgrades on every route.
	reverse_proxy /notifications* {$NOTIFICATIONS_UPSTREAM}

	# /rounds → round-service (Round Manager: the first stateful, multi-user,
	# realtime-shared Widget — owns tables and its own authenticated per-Bene
	# WebSocket). Serves its routes and its bundle under /rounds; the upstream is
	# injected per-environment. Caddy carries the WebSocket upgrade on every route,
	# so the later WS slice needs no Caddyfile change.
	reverse_proxy /rounds* {$ROUND_UPSTREAM}

	# /likert → likert-service (Scala Likert: a read Widget that owns a small
	# ratings cache and serves its single JWT-guarded data route + its unguarded
	# bundle under /likert). Path is preserved and the upstream is injected
	# per-environment.
	reverse_proxy /likert* {$LIKERT_UPSTREAM}

	# /prezzari → prezzari-service (I Prezziari: a read Widget serving two static
	# reference price lists — the OMI locazione of the clicked comune and a curated
	# Regione Campania prezzario slice — via its two JWT-guarded data routes + its
	# unguarded bundle under /prezzari). Path is preserved and the upstream is
	# injected per-environment.
	reverse_proxy /prezzari* {$PREZZARI_UPSTREAM}

	# Registering a Widget is THIS — one route line, claiming a fresh top-level
	# prefix above the frontend catch-all. /geo-layers is the worked example: a new
	# layers-style service. Strangling a route off the monolith is the same one-line
	# move in reverse — re-point an entry's upstream from the monolith to the new
	# service. A new prefix must not collide with a monolith prefix below or with a
	# frontend page route (/dashboard, /login, /signup, /configuration).
	reverse_proxy /geo-layers* {$GEO_LAYERS_UPSTREAM}

	# --- Monolith backend: its finite, enumerated API surface ---
	#
	# These are every top-level prefix the monolith's routers mount (src/app.py:
	# auth, weather, pois, reviews, situation, areas, pollution, layers, dashboards,
	# euklid, data-upload) plus /health and FastAPI's docs endpoints. Because the
	# frontend is now the catch-all, a monolith route MUST appear here or its calls
	# would fall through to the frontend and 404 — so when the monolith adds a NEW
	# top-level prefix, add it to this matcher (the one place the backend surface is
	# listed). The monolith's own files stay byte-for-byte unchanged.
	@monolith path /auth* /weather* /pois* /reviews* /situation* /areas* /pollution* /layers* /dashboards* /euklid* /data-upload* /health /docs /openapi.json /redoc
	reverse_proxy @monolith {$MONOLITH_UPSTREAM}

	# --- Catch-all → the Next frontend (the monolith frontend, unchanged) ---
	#
	# Everything not claimed above — the site root, all frontend pages, the /_next/*
	# framework assets (CSS/JS/HMR), and public files — is served by the Next app.
	# This is what makes the frontend render correctly through the single origin:
	# its assets resolve to the Next server, not to a backend that doesn't have them.
	reverse_proxy {$FRONTEND_UPSTREAM}
}
