# Secrets / local env — never commit.
.env

# Large DB dumps — restore locally, don't version
/data/

# Claude Code working artifacts (PRDs, tasks, logs) — personal workflow, not versioned
/.scratch/

# Monolith runtime logs (euklid writes into its own src tree at import)
monolith/backend/src/routers/euklid/agent/logs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Node / Next
node_modules/
.next/
